<Window x:Class="CalcKall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CalcKall"
        mc:Ignorable="d"
        Title="Калькулятор калорий" Height="600" Width="900">
    <TabControl Margin="10">

        <TabItem Header="Калькулятор">
            <Grid Background="SeaShell" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Пол:" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox x:Name="GenderBox" Grid.Row="0" Grid.Column="1" Margin="0,5">
                    <ComboBoxItem Content="Мужской" IsSelected="True"/>
                    <ComboBoxItem Content="Женский"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Вес (кг):" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="WeightBox" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Рост (см):" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="HeightBox" Grid.Row="2" Grid.Column="1" Margin="0,5"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Возраст:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="AgeBox" Grid.Row="3" Grid.Column="1" Margin="0,5"/>

                <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                        Content="Рассчитать" Click="Calculate_Click"
                        Height="35" Margin="0,15,0,10"/>

                <TextBlock x:Name="ResultBlock"
                           Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                           FontSize="18" FontWeight="Bold"
                           TextWrapping="Wrap" TextAlignment="Center"/>
            </Grid>
        </TabItem>

        <TabItem Header="Таблица калорий">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Пол:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="TableGenderBox" Width="100" Margin="0,0,15,0">
                        <ComboBoxItem Content="Мужской" IsSelected="True"/>
                        <ComboBoxItem Content="Женский"/>
                    </ComboBox>

                    <TextBlock Text="Возраст:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TableAgeBox" Width="60" Text="30" Margin="0,0,15,0"/>

                    <TextBlock Text="Активность:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="TableActivityBox" Width="120" Margin="0,0,15,0">
                        <ComboBoxItem Content="Min"/>
                        <ComboBoxItem Content="Low"/>
                        <ComboBoxItem Content="Medium" IsSelected="True"/>
                        <ComboBoxItem Content="High"/>
                        <ComboBoxItem Content="VeryHigh"/>
                    </ComboBox>

                    <Button Content="Построить таблицу"
                            Click="BuildTable_Click"
                            Padding="10,2"/>
                </WrapPanel>

                <TextBlock Grid.Row="1" x:Name="TableInfoBlock"
                           Foreground="DarkSlateGray" Margin="0,0,0,10"/>

                <DataGrid Grid.Row="2"
                          x:Name="CalorieGrid"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          AlternatingRowBackground="LightGray"
                          HeadersVisibility="Column"/>
            </Grid>
        </TabItem>

    </TabControl>
</Window>